<?xml version="1.0" encoding="utf-8"?>
<!--
    TextureView rather than SurfaceView: the player surface has to survive picture-in-picture
    and a dialog window (the sheets) covering it, and a SurfaceView renders black in both
    cases because its layer is not composited into the activity's window.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="never" />
